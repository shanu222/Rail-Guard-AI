// RAILGUARD AI - database schema (PostgreSQL 16 + PostGIS).
// Geometry columns use Unsupported(): read/write them with raw SQL (ST_* functions).
// GIST indexes and a few SQL views are added by hand in the migration (see migrations/*/migration.sql).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ---------- enums ----------

enum Role {
  ADMIN
  DIVISIONAL_ENGINEER
  INSPECTOR
  VIEWER
}

enum DeviceType {
  TRACK
  CROSSING
}

enum DeviceStatus {
  ONLINE
  DEGRADED
  OFFLINE
}

enum NetworkType {
  LTE_4G
  LTE_3G
  WIFI
  SATELLITE
  NONE
}

enum CrossingStatus {
  ACTIVE
  MAINTENANCE
  OFFLINE
}

enum DefectClass {
  MISSING_FASTENER
  BROKEN_FASTENER
  DAMAGED_SLEEPER
  RAIL_SURFACE_DEFECT
  RAIL_JOINT_PROBLEM
  BALLAST_DEFICIENCY
  VEGETATION
  GEOMETRY_IRREGULARITY
}

enum Severity {
  MINOR
  MODERATE
  SEVERE
}

enum DetectionSource {
  IMAGE
  VIBRATION
  ACOUSTIC
}

enum FusionLevel {
  HIGH
  REVIEW
}

enum ReviewStatus {
  PENDING
  CONFIRMED
  REJECTED
  NEEDS_INFO
}

enum CrossingObjectClass {
  CAR
  MOTORCYCLE
  RICKSHAW
  CART
  TRACTOR
  PERSON
  LIVESTOCK
  OTHER
}

enum WorkOrderStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum WorkOrderPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ModelType {
  TRACK_DEFECT
  CROSSING_VISION
  RISK_ENGINE
}

// ---------- organisation & geography ----------

model Division {
  id   String @id @default(uuid()) @db.Uuid
  name String
  code String @unique

  sections  Section[]
  crossings Crossing[]
  devices   Device[]
  users     User[]

  @@map("divisions")
}

model Section {
  id          String   @id @default(uuid()) @db.Uuid
  divisionId  String   @map("division_id") @db.Uuid
  name        String
  fromStation String   @map("from_station")
  toStation   String   @map("to_station")
  lengthKm    Float    @map("length_km")
  geom        Unsupported("geometry(LineString,4326)")
  createdAt   DateTime @default(now()) @map("created_at")

  division Division      @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  segments Segment[]
  runs     Run[]
  weather  WeatherInput[]
  users    UserSection[]

  @@index([divisionId])
  @@map("sections")
}

model Segment {
  id               String  @id @default(uuid()) @db.Uuid
  sectionId        String  @map("section_id") @db.Uuid
  chainageStartM   Int     @map("chainage_start_m")
  chainageEndM     Int     @map("chainage_end_m")
  geom             Unsupported("geometry(LineString,4326)")
  isCurve          Boolean @default(false) @map("is_curve")
  hasBridge        Boolean @default(false) @map("has_bridge")
  nearCrossingId   String? @map("near_crossing_id") @db.Uuid
  heatExposure     Float   @default(0) @map("heat_exposure") // 0..1
  floodExposure    Float   @default(0) @map("flood_exposure") // 0..1

  section      Section       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  nearCrossing Crossing?     @relation(fields: [nearCrossingId], references: [id], onDelete: SetNull)
  detections   Detection[]
  riskScores   RiskScore[]
  workOrders   WorkOrder[]
  weather      WeatherInput[]

  @@unique([sectionId, chainageStartM])
  @@index([nearCrossingId])
  @@map("segments")
}

model Crossing {
  id         String         @id @default(uuid()) @db.Uuid
  divisionId String         @map("division_id") @db.Uuid
  name       String
  geom       Unsupported("geometry(Point,4326)")
  status     CrossingStatus @default(ACTIVE)
  /// Polygon in image (pixel) coordinates, e.g. [[x,y],...]; configured per camera.
  dangerZone Json?          @map("danger_zone")
  unitId     String?        @unique @map("unit_id") @db.Uuid
  createdAt  DateTime       @default(now()) @map("created_at")

  division Division        @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  unit     Device?         @relation(fields: [unitId], references: [id], onDelete: SetNull)
  events   CrossingEvent[]
  segments Segment[]

  @@index([divisionId])
  @@map("crossings")
}

// ---------- devices & runs ----------

model Device {
  id              String       @id @default(uuid()) @db.Uuid
  type            DeviceType
  serial          String       @unique
  name            String
  divisionId      String       @map("division_id") @db.Uuid
  firmwareVersion String?      @map("firmware_version")
  modelVersion    String?      @map("model_version")
  lastSeenAt      DateTime?    @map("last_seen_at")
  batteryPct      Float?       @map("battery_pct")
  solarW          Float?       @map("solar_w")
  temperatureC    Float?       @map("temperature_c")
  storagePct      Float?       @map("storage_pct")
  network         NetworkType?
  status          DeviceStatus @default(OFFLINE)
  /// Argon2/SHA-256 hash of the device API key; the plaintext is shown once at creation.
  apiKeyHash      String?      @map("api_key_hash")
  apiKeyPrefix    String?      @map("api_key_prefix")
  revokedAt       DateTime?    @map("revoked_at")
  isDemo          Boolean      @default(false) @map("is_demo")
  createdAt       DateTime     @default(now()) @map("created_at")

  division       Division        @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  crossing       Crossing?
  runs           Run[]
  detections     Detection[]
  crossingEvents CrossingEvent[]

  @@index([divisionId, type])
  @@index([lastSeenAt])
  @@map("devices")
}

model Run {
  id           String    @id @default(uuid()) @db.Uuid
  deviceId     String    @map("device_id") @db.Uuid
  sectionId    String?   @map("section_id") @db.Uuid
  startedAt    DateTime  @map("started_at")
  endedAt      DateTime? @map("ended_at")
  distanceKm   Float?    @map("distance_km")
  speedAvgKmh  Float?    @map("speed_avg_kmh")
  samplesCount Int       @default(0) @map("samples_count")

  device     Device      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  section    Section?    @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  detections Detection[]

  @@index([deviceId, startedAt])
  @@index([sectionId, startedAt])
  @@map("runs")
}

// ---------- detections & crossing events ----------

model Detection {
  /// Client-generated UUID => ingestion is idempotent (INSERT ... ON CONFLICT DO NOTHING).
  id           String            @id @db.Uuid
  runId        String?           @map("run_id") @db.Uuid
  deviceId     String            @map("device_id") @db.Uuid
  segmentId    String?           @map("segment_id") @db.Uuid
  geom         Unsupported("geometry(Point,4326)")
  chainageM    Int?              @map("chainage_m")
  detectedAt   DateTime          @map("detected_at") // device time (untrusted)
  receivedAt   DateTime          @default(now()) @map("received_at") // server time (trusted)
  defectClass  DefectClass       @map("defect_class")
  severity     Severity
  confidence   Float
  sources      DetectionSource[]
  fusionLevel  FusionLevel       @map("fusion_level")
  imageKey     String?           @map("image_key")
  audioKey     String?           @map("audio_key")
  reviewStatus ReviewStatus      @default(PENDING) @map("review_status")
  reviewedById String?           @map("reviewed_by") @db.Uuid
  reviewedAt   DateTime?         @map("reviewed_at")
  reviewNote   String?           @map("review_note")
  isDemo       Boolean           @default(false) @map("is_demo")

  run        Run?     @relation(fields: [runId], references: [id], onDelete: SetNull)
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  segment    Segment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  reviewedBy User?    @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([segmentId, detectedAt])
  @@index([reviewStatus, detectedAt])
  @@index([severity, reviewStatus])
  @@index([deviceId, detectedAt])
  @@index([defectClass])
  @@map("detections")
}

model CrossingEvent {
  id               String              @id @db.Uuid // client-generated => idempotent
  crossingId       String              @map("crossing_id") @db.Uuid
  deviceId         String              @map("device_id") @db.Uuid
  occurredAt       DateTime            @map("occurred_at")
  receivedAt       DateTime            @default(now()) @map("received_at")
  objectClass      CrossingObjectClass @map("object_class")
  trainApproaching Boolean             @map("train_approaching")
  dwellSeconds     Float               @map("dwell_seconds")
  warningTriggered Boolean             @map("warning_triggered")
  snapshotKey      String?             @map("snapshot_key")
  snapshotPurgedAt DateTime?           @map("snapshot_purged_at") // privacy retention
  confidence       Float
  isDemo           Boolean             @default(false) @map("is_demo")

  crossing Crossing @relation(fields: [crossingId], references: [id], onDelete: Cascade)
  device   Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([crossingId, occurredAt])
  @@index([warningTriggered, occurredAt])
  @@map("crossing_events")
}

// ---------- risk, work, weather, models ----------

model RiskScore {
  id           String   @id @default(uuid()) @db.Uuid
  segmentId    String   @map("segment_id") @db.Uuid
  computedAt   DateTime @default(now()) @map("computed_at")
  score        Int // 1..5
  rawValue     Float    @map("raw_value")
  /// See RiskComponentsSchema in @railguard/shared - lets the UI explain every score.
  components   Json
  modelVersion String   @map("model_version")

  segment Segment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@index([segmentId, computedAt(sort: Desc)])
  @@index([computedAt])
  @@map("risk_scores")
}

model WorkOrder {
  id           String            @id @default(uuid()) @db.Uuid
  segmentId    String            @map("segment_id") @db.Uuid
  detectionIds String[]          @default([]) @map("detection_ids") @db.Uuid
  priority     WorkOrderPriority @default(MEDIUM)
  assignedToId String?           @map("assigned_to") @db.Uuid
  createdById  String?           @map("created_by") @db.Uuid
  dueDate      DateTime?         @map("due_date") @db.Date
  status       WorkOrderStatus   @default(OPEN)
  notes        String?
  photos       String[]          @default([])
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  closedAt     DateTime?         @map("closed_at")

  segment    Segment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  assignedTo User?   @relation("WorkOrderAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy  User?   @relation("WorkOrderCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status, dueDate])
  @@index([assignedToId, status])
  @@index([segmentId])
  @@map("work_orders")
}

model WeatherInput {
  id         String   @id @default(uuid()) @db.Uuid
  segmentId  String?  @map("segment_id") @db.Uuid
  sectionId  String?  @map("section_id") @db.Uuid
  date       DateTime @db.Date
  maxTempC   Float?   @map("max_temp_c")
  rainfallMm Float?   @map("rainfall_mm")
  floodFlag  Boolean  @default(false) @map("flood_flag")
  isDemo     Boolean  @default(false) @map("is_demo")

  segment Segment? @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  section Section? @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId, date])
  @@index([segmentId, date])
  @@map("weather_inputs")
}

model ModelVersion {
  id         String    @id @default(uuid()) @db.Uuid
  type       ModelType
  version    String
  metrics    Json?
  releasedAt DateTime  @default(now()) @map("released_at")
  r2Key      String?   @map("r2_key")
  isActive   Boolean   @default(false) @map("is_active")
  isDemo     Boolean   @default(false) @map("is_demo")

  @@unique([type, version])
  @@map("model_versions")
}

// ---------- users, audit, notifications, settings ----------

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  name         String
  role         Role
  divisionId   String?   @map("division_id") @db.Uuid // null => all divisions (Admin)
  passwordHash String    @map("password_hash")
  totpSecret   String?   @map("totp_secret")
  totpEnabled  Boolean   @default(false) @map("totp_enabled")
  failedLogins Int       @default(0) @map("failed_logins")
  lockedUntil  DateTime? @map("locked_until")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastLoginAt  DateTime? @map("last_login_at")

  division        Division?      @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  sections        UserSection[]
  refreshTokens   RefreshToken[]
  reviewed        Detection[]
  assignedOrders  WorkOrder[]    @relation("WorkOrderAssignee")
  createdOrders   WorkOrder[]    @relation("WorkOrderCreator")
  notifications   Notification[]
  auditEntries    AuditLog[]

  @@index([divisionId, role])
  @@map("users")
}

/// Sections an Inspector is assigned to.
model UserSection {
  userId    String @map("user_id") @db.Uuid
  sectionId String @map("section_id") @db.Uuid

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@id([userId, sectionId])
  @@map("user_sections")
}

/// Refresh-token rotation: each token is single-use; reuse of a rotated token revokes the family.
model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  familyId   String    @map("family_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  rotatedAt  DateTime? @map("rotated_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  userAgent  String?   @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  deviceId  String?  @map("device_id") @db.Uuid
  action    String // e.g. detection.review, work_order.create
  entity    String
  entityId  String?  @map("entity_id")
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("audit_log")
}

model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  divisionId String?   @map("division_id") @db.Uuid
  type       String // SEVERE_DETECTION | CROSSING_WARNING | DEVICE_OFFLINE | ...
  title      String
  body       String?
  data       Json?
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([divisionId, createdAt])
  @@map("notifications")
}

/// Key/value runtime configuration: risk_config, report_baseline, snapshot_retention_days, ...
model Setting {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}
