# --- Database / queue ---
DATABASE_URL=postgresql://railguard:railguard@localhost:5432/railguard?schema=public
REDIS_URL=redis://localhost:6379

# --- Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ---
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=14

# --- Object storage: MinIO locally, Cloudflare R2 in production ---
R2_ACCOUNT_ID=local
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET=railguard-media
# Leave empty for real R2 (endpoint is derived from R2_ACCOUNT_ID). Set for MinIO:
R2_ENDPOINT=http://localhost:9000

# --- HTTP ---
PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- Behaviour ---
# true => seeded/simulated data is allowed and the UI shows a "DEMO DATA" badge.
DEMO_MODE=true
SNAPSHOT_RETENTION_DAYS=30

# --- Seed only ---
# Password given to the demo users created by `pnpm db:seed` (never used when DEMO_MODE is not true).
SEED_DEMO_PASSWORD=Railguard-Demo-2026
